{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isoforge.dev/schemas/character/v4.schema.json",
  "title": "character@4",
  "description": "SRD 5.1 character, v4 = character@3 carried in full (docs/proposals/VERSION_BUMP_BATCH.md 1.3) on common@2: everything monster@4 adds plus resources[] pools and equipment item references. Migrated @3 files carry inert stamps (never authored on disk). Integers only (4.3).",
  "$ref": "../common/v2.schema.json#/$defs/stat_block",
  "unevaluatedProperties": false,
  "required": [
    "race",
    "classes",
    "level"
  ],
  "properties": {
    "spellcasting": {
      "$ref": "../common/v2.schema.json#/$defs/spellcasting"
    },
    "$schema": {
      "const": "character@4"
    },
    "race": {
      "type": "string",
      "pattern": "^[a-z_]+$",
      "description": "SRD race id, e.g. 'human'."
    },
    "background": {
      "type": "string"
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "description": "Total character level (sum of classes[].level)."
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class",
          "level",
          "hit_die"
        ],
        "properties": {
          "class": {
            "enum": [
              "barbarian",
              "bard",
              "cleric",
              "druid",
              "fighter",
              "monk",
              "paladin",
              "ranger",
              "rogue",
              "sorcerer",
              "warlock",
              "wizard"
            ]
          },
          "subclass": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "hit_die": {
            "enum": [
              "d6",
              "d8",
              "d10",
              "d12"
            ]
          }
        }
      }
    },
    "xp": {
      "type": "integer",
      "minimum": 0,
      "description": "Current experience points."
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "../common/v2.schema.json#/$defs/trait_active"
      },
      "description": "Class/race features. Effects are mechanically active (see schema description); never bake their numbers into actions."
    },
    "equipment": {
      "type": "array",
      "description": "Bare strings are the descriptive @3 entries (never loaded). {item, equipped?, value_gp?} objects reference an item@1 document by content id and are live (docs/proposals/VERSION_BUMP_BATCH.md 10).",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item"
            ],
            "properties": {
              "item": {
                "$ref": "../common/v1.schema.json#/$defs/content_id"
              },
              "equipped": {
                "type": "boolean"
              },
              "value_gp": {
                "type": "integer",
                "minimum": 0,
                "description": "Value in gp of this entry (a priced material component: an entry satisfies a spell's components.m when its item id matches and value_gp * 100 >= cost_cp; Director ruling). Such an entry needs no item@1 document."
              }
            }
          }
        ]
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "description": "Simulation behaviour hooks.",
      "properties": {
        "ai": {
          "type": "string",
          "pattern": "^scripts/.+\\.luau$",
          "description": "Pack-relative strict Luau AI script."
        }
      }
    },
    "forward_compat": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "elevation"
        ]
      },
      "description": "Opt-in flags for engine features that are not implemented yet (elevation, T&C-G12). Descriptive and ignored by sim; listed with the inert mechanics. New enum values widen the @4 schemas additively."
    },
    "inert_mechanics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "Mechanics the document carries but the engine must ignore (e.g. 'reactions', 'bonus_actions', 'equipment', 'damage[1..]'). Written by the 3->4 migration; a hand-written @4 file may carry it too."
    }
  }
}
