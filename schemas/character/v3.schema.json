{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isoforge.dev/schemas/character/v3.schema.json",
  "title": "character@3",
  "description": "character@3 (minimal, engine-side; T&C to own): character@1 + optional behavior.ai; features[]/traits[] effect objects are mechanically applied by the engine, so stat-block numbers must NOT bake them in. SRD 5.1 player character / NPC built from classes. Same stat-block core as monster@1, but level/class instead of CR/XP. Integers only (§4.3).",
  "$ref": "../common/v1.schema.json#/$defs/stat_block",
  "unevaluatedProperties": false,
  "required": ["race", "classes", "level"],
  "properties": {
    "$schema": { "const": "character@3" },
    "race": { "type": "string", "pattern": "^[a-z_]+$", "description": "SRD race id, e.g. 'human'." },
    "background": { "type": "string" },
    "level": { "type": "integer", "minimum": 1, "maximum": 20, "description": "Total character level (sum of classes[].level)." },
    "classes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["class", "level", "hit_die"],
        "properties": {
          "class": { "enum": ["barbarian", "bard", "cleric", "druid", "fighter", "monk", "paladin",
                              "ranger", "rogue", "sorcerer", "warlock", "wizard"] },
          "subclass": { "type": "string" },
          "level": { "type": "integer", "minimum": 1, "maximum": 20 },
          "hit_die": { "enum": ["d6", "d8", "d10", "d12"] }
        }
      }
    },
    "xp": { "type": "integer", "minimum": 0, "description": "Current experience points." },
    "behavior": { "type": "object", "additionalProperties": false, "properties": { "ai": { "type": "string" } } },
    "features": { "type": "array", "items": { "$ref": "../common/v1.schema.json#/$defs/trait" } },
    "equipment": { "type": "array", "items": { "type": "string" } }
  }
}
