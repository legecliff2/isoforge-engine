{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isoforge.dev/schemas/character/v2.schema.json",
  "title": "character@2",
  "description": "SRD 5.1 player character / NPC, v2 = character@1 + optional top-level behavior (append-only). behavior.ai is a strict Luau script (same rules as monster@2), e.g. for NPC allies or auto-play; player-controlled PCs omit it. Integers only (§4.3).",
  "$ref": "../common/v1.schema.json#/$defs/stat_block",
  "unevaluatedProperties": false,
  "required": [
    "race",
    "classes",
    "level"
  ],
  "properties": {
    "$schema": {
      "const": "character@2"
    },
    "race": {
      "type": "string",
      "pattern": "^[a-z_]+$",
      "description": "SRD race id, e.g. 'human'."
    },
    "background": {
      "type": "string"
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "description": "Total character level (sum of classes[].level)."
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class",
          "level",
          "hit_die"
        ],
        "properties": {
          "class": {
            "enum": [
              "barbarian",
              "bard",
              "cleric",
              "druid",
              "fighter",
              "monk",
              "paladin",
              "ranger",
              "rogue",
              "sorcerer",
              "warlock",
              "wizard"
            ]
          },
          "subclass": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "hit_die": {
            "enum": [
              "d6",
              "d8",
              "d10",
              "d12"
            ]
          }
        }
      }
    },
    "xp": {
      "type": "integer",
      "minimum": 0,
      "description": "Current experience points."
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "../common/v1.schema.json#/$defs/trait"
      }
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "description": "Simulation behaviour hooks.",
      "properties": {
        "ai": {
          "type": "string",
          "pattern": "^scripts/.+\\.luau$",
          "description": "Pack-relative strict Luau AI script."
        }
      }
    }
  }
}
