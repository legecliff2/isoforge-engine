{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isoforge.dev/schemas/manifest/v1.schema.json",
  "title": "manifest@1",
  "description": "Content pack manifest (ARCHITECTURE.md §3.1, §3.4, §3.6). 'attribution' is mandatory (Licensing note).",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "id", "version", "engine_min", "feature_level", "api_level", "rules_profile", "requires", "attribution"],
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$" },
    "capability": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*\\.v[1-9][0-9]*$|^rules\\.srd[0-9]+$" },
    "pack_id": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$" }
  },
  "properties": {
    "$schema": { "const": "manifest@1" },
    "id": { "$ref": "#/$defs/pack_id" },
    "name": { "type": "string" },
    "version": { "$ref": "#/$defs/semver" },
    "engine_min": { "$ref": "#/$defs/semver" },
    "feature_level": { "type": "integer", "minimum": 1 },
    "api_level": { "enum": [1, 2], "description": "Script API level; levels 1 and 2 exist (level 2's definitions are minimal until row 16b, docs/proposals/VERSION_BUMP_BATCH.md section 8.5). A pack runs at its own level on a host whose maximum is >= that level." },
    "rules_profile": { "type": "string", "pattern": "^srd51(-[0-9a-z]+)?$" },
    "requires": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "uniqueItems": true },
    "optional": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "uniqueItems": true },
    "depends": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "version"],
        "properties": {
          "id": { "$ref": "#/$defs/pack_id" },
          "version": { "type": "string", "pattern": "^(\\^|~|>=)?(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*)){0,2}$",
                       "description": "Version range. Supported dialect (validator and engine PackSet): X.Y.Z (exact), ^X.Y, ^X.Y.Z, ~X.Y.Z, >=X.Y.Z; integers only, no prerelease. Other forms the pattern admits are rejected by the validator (bad_range)." }
        }
      }
    },
    "attribution": { "type": "string", "minLength": 1, "pattern": "System Reference Document 5\\.1" },
    "entry_script": { "type": "string", "pattern": "^scripts/.+\\.luau$" },
    "contents": {
      "type": "array",
      "description": "Pack-relative data files and scripts (every *.json except manifest.json, and every scripts/**/*.luau), in stable (sorted) order. The validator checks both directions; the engine ignores non-.json entries.",
      "items": { "type": "string", "pattern": "^[a-z0-9_./-]+\\.(json|luau)$" },
      "uniqueItems": true
    }
  }
}
