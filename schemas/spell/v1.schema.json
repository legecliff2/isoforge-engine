{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isoforge.dev/schemas/spell/v1.schema.json",
  "title": "spell@1",
  "description": "SRD 5.1 spell. Rules-facing data: rules5e_content maps it to rules5e::SpellDef (engine/rules/content). 'effects' is an array of one or more effects (reaction kinds stand alone; a zone is the first effect only; extra effects resolve in order over the same targets and may use applies_to: affected). Cross-field rules are in tools/validate (check_spell) and mirrored by the loader. Integers only (\u00a74.3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "name",
    "source",
    "level",
    "school",
    "casting_time",
    "range",
    "components",
    "duration",
    "effects"
  ],
  "properties": {
    "$schema": {
      "const": "spell@1"
    },
    "id": {
      "$ref": "#/$defs/spell_id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "../common/v1.schema.json#/$defs/source"
    },
    "description": {
      "type": "string"
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9,
      "description": "0 = cantrip."
    },
    "school": {
      "enum": [
        "abjuration",
        "conjuration",
        "divination",
        "enchantment",
        "evocation",
        "illusion",
        "necromancy",
        "transmutation"
      ]
    },
    "classes": {
      "type": "array",
      "items": {
        "$ref": "../common/v1.schema.json#/$defs/class_name"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "ritual": {
      "type": "boolean",
      "description": "Can be cast as a ritual (+10 minutes, no slot; outside encounters)."
    },
    "casting_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "action",
            "bonus_action",
            "reaction",
            "minute",
            "hour"
          ]
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "description": "minute / hour only."
        },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "description": "Reaction only: the rules5e ReactionTrigger window that offers this spell.",
          "properties": {
            "kind": {
              "enum": [
                "being_hit",
                "spell_cast"
              ]
            },
            "or_targeted_by": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/spell_id"
              },
              "minItems": 1,
              "uniqueItems": true,
              "description": "being_hit: also offered when targeted by these spells (Shield: Magic Missile)."
            },
            "requires_sight": {
              "type": "boolean",
              "description": "The reactor must see the triggering creature (Counterspell)."
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "reaction"
              }
            }
          },
          "then": {
            "required": [
              "trigger"
            ]
          },
          "else": {
            "not": {
              "required": [
                "trigger"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "minute",
                  "hour"
                ]
              }
            }
          },
          "then": {
            "required": [
              "amount"
            ]
          },
          "else": {
            "not": {
              "required": [
                "amount"
              ]
            }
          }
        }
      ]
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "self",
            "touch",
            "ranged"
          ]
        },
        "feet": {
          "type": "integer",
          "minimum": 5,
          "multipleOf": 5
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "ranged"
          }
        }
      },
      "then": {
        "required": [
          "feet"
        ]
      },
      "else": {
        "not": {
          "required": [
            "feet"
          ]
        }
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "size_ft"
      ],
      "description": "Area of effect; sim decides which creatures are inside and passes them as targets.",
      "properties": {
        "shape": {
          "enum": [
            "cone",
            "cube",
            "cylinder",
            "line",
            "sphere"
          ]
        },
        "size_ft": {
          "type": "integer",
          "minimum": 5,
          "multipleOf": 5,
          "description": "Cone/line length, cube side, sphere/cylinder radius."
        },
        "width_ft": {
          "type": "integer",
          "minimum": 5,
          "multipleOf": 5,
          "description": "line only."
        },
        "height_ft": {
          "type": "integer",
          "minimum": 5,
          "multipleOf": 5,
          "description": "cylinder only."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "shape": {
                "const": "line"
              }
            }
          },
          "then": {
            "required": [
              "width_ft"
            ]
          },
          "else": {
            "not": {
              "required": [
                "width_ft"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "shape": {
                "const": "cylinder"
              }
            }
          },
          "then": {
            "required": [
              "height_ft"
            ]
          },
          "else": {
            "not": {
              "required": [
                "height_ft"
              ]
            }
          }
        }
      ]
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "v": {
          "const": true
        },
        "s": {
          "const": true
        },
        "m": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "cost_cp": {
              "type": "integer",
              "minimum": 1,
              "description": "Cost in copper pieces (integers only)."
            },
            "consumed": {
              "type": "boolean"
            }
          },
          "dependentRequired": {
            "consumed": [
              "cost_cp"
            ]
          }
        }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "instantaneous",
            "rounds",
            "minutes",
            "hours",
            "until_start_of_caster_turn",
            "until_dispelled",
            "special"
          ]
        },
        "amount": {
          "type": "integer",
          "minimum": 1
        },
        "concentration": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "rounds",
                  "minutes",
                  "hours"
                ]
              }
            }
          },
          "then": {
            "required": [
              "amount"
            ]
          },
          "else": {
            "not": {
              "required": [
                "amount"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "instantaneous",
                  "until_start_of_caster_turn"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "concentration"
              ]
            }
          }
        }
      ]
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count"
      ],
      "description": "Creatures affected at the spell's base level. Omitted: one creature (or self / area / per-dart, by effect).",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "creature_type": {
          "$ref": "../common/v1.schema.json#/$defs/creature_types",
          "description": "Only these creature types are valid targets."
        },
        "max_spread_ft": {
          "type": "integer",
          "minimum": 5,
          "multipleOf": 5,
          "description": "Targets must be within this distance of each other."
        }
      }
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/effect"
      },
      "description": "One or more effects, resolved in order over the same targets. The first effect carries targeting and scaling; reaction effects (ac_bonus, counter) must be the only effect. Extra effects do not scale with slot or caster level."
    },
    "scaling": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "cantrip": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "levels",
            "adds"
          ],
          "properties": {
            "levels": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 2,
                "maximum": 20
              },
              "minItems": 1,
              "maxItems": 3,
              "uniqueItems": true,
              "description": "Caster levels (ascending) at which the cantrip grows (SRD: 5, 11, 17)."
            },
            "adds": {
              "enum": [
                "dice",
                "beams"
              ],
              "description": "dice: base dice again; beams: one more beam."
            }
          }
        },
        "upcast": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "description": "Per slot level above the spell's level.",
          "properties": {
            "dice": {
              "type": "integer",
              "minimum": 1
            },
            "darts": {
              "type": "integer",
              "minimum": 1
            },
            "beams": {
              "type": "integer",
              "minimum": 1
            },
            "targets": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "spell_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*\\.spell\\.[a-z0-9_]+$",
      "description": "Content id of a spell ('<ns>.spell.<name>'). Runtime id = FNV-1a 32 of it (rules5e::spell_id_of); collisions are load errors."
    },
    "damage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dice",
        "type"
      ],
      "properties": {
        "dice": {
          "$ref": "../common/v1.schema.json#/$defs/dice"
        },
        "type": {
          "$ref": "../common/v1.schema.json#/$defs/damage_type"
        }
      }
    },
    "effect": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "spell_attack",
            "save",
            "heal",
            "auto_hit",
            "ac_bonus",
            "counter",
            "apply_condition",
            "apply_modifier",
            "zone"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "spell_attack"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "kind",
              "attack",
              "damage"
            ],
            "properties": {
              "kind": {
                "const": "spell_attack"
              },
              "attack": {
                "enum": [
                  "melee",
                  "ranged"
                ]
              },
              "damage": {
                "$ref": "#/$defs/damage"
              },
              "beams": {
                "type": "integer",
                "minimum": 1,
                "description": "Separate attack rolls (default 1); one target, or one per beam."
              },
              "description": {
                "type": "string"
              },
              "applies_to": {
                "enum": [
                  "all",
                  "affected"
                ],
                "description": "Effects after the first only: 'affected' resolves this effect only for the targets the previous effect affected (spell attack: hit; save: failed; heal: healed; auto_hit: struck; apply_condition: received it). Default 'all'."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "save"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "kind",
              "ability"
            ],
            "anyOf": [
              {
                "required": [
                  "damage"
                ]
              },
              {
                "required": [
                  "condition"
                ]
              }
            ],
            "dependentRequired": {
              "damage": [
                "on_success"
              ],
              "on_success": [
                "damage"
              ],
              "repeat_save": [
                "condition"
              ]
            },
            "properties": {
              "kind": {
                "const": "save"
              },
              "ability": {
                "$ref": "../common/v1.schema.json#/$defs/ability"
              },
              "damage": {
                "$ref": "#/$defs/damage"
              },
              "on_success": {
                "enum": [
                  "half",
                  "none"
                ],
                "description": "Damage on a successful save."
              },
              "condition": {
                "$ref": "../common/v1.schema.json#/$defs/condition"
              },
              "repeat_save": {
                "enum": [
                  "start_of_turn",
                  "end_of_turn",
                  "on_damage"
                ],
                "description": "When the target repeats the save; success ends the condition."
              },
              "description": {
                "type": "string"
              },
              "applies_to": {
                "enum": [
                  "all",
                  "affected"
                ],
                "description": "Effects after the first only: 'affected' resolves this effect only for the targets the previous effect affected (spell attack: hit; save: failed; heal: healed; auto_hit: struck; apply_condition: received it). Default 'all'."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "heal"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "kind",
              "dice"
            ],
            "properties": {
              "kind": {
                "const": "heal"
              },
              "dice": {
                "$ref": "../common/v1.schema.json#/$defs/dice"
              },
              "add_spellcasting_modifier": {
                "type": "boolean"
              },
              "excludes_creature_type": {
                "$ref": "../common/v1.schema.json#/$defs/creature_types",
                "description": "No effect on these (Cure Wounds: undead, construct)."
              },
              "description": {
                "type": "string"
              },
              "applies_to": {
                "enum": [
                  "all",
                  "affected"
                ],
                "description": "Effects after the first only: 'affected' resolves this effect only for the targets the previous effect affected (spell attack: hit; save: failed; heal: healed; auto_hit: struck; apply_condition: received it). Default 'all'."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "auto_hit"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "kind",
              "darts",
              "damage",
              "distribution",
              "simultaneous"
            ],
            "properties": {
              "kind": {
                "const": "auto_hit"
              },
              "darts": {
                "type": "integer",
                "minimum": 1
              },
              "damage": {
                "$ref": "#/$defs/damage"
              },
              "distribution": {
                "enum": [
                  "any",
                  "single",
                  "distinct"
                ],
                "description": "any: darts split freely; single: all at one creature; distinct: each at a different creature."
              },
              "simultaneous": {
                "type": "boolean",
                "description": "All darts strike at once: every target reacts before any damage."
              },
              "description": {
                "type": "string"
              },
              "applies_to": {
                "enum": [
                  "all",
                  "affected"
                ],
                "description": "Effects after the first only: 'affected' resolves this effect only for the targets the previous effect affected (spell attack: hit; save: failed; heal: healed; auto_hit: struck; apply_condition: received it). Default 'all'."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ac_bonus"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "kind",
              "bonus"
            ],
            "properties": {
              "kind": {
                "const": "ac_bonus"
              },
              "bonus": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "blocks_spell": {
                "$ref": "#/$defs/spell_id",
                "description": "Immune to this spell's damage while the bonus lasts (Shield: Magic Missile)."
              },
              "description": {
                "type": "string"
              },
              "applies_to": {
                "enum": [
                  "all",
                  "affected"
                ],
                "description": "Effects after the first only: 'affected' resolves this effect only for the targets the previous effect affected (spell attack: hit; save: failed; heal: healed; auto_hit: struck; apply_condition: received it). Default 'all'."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "counter"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "kind",
              "auto_max_level",
              "check"
            ],
            "properties": {
              "kind": {
                "const": "counter"
              },
              "auto_max_level": {
                "const": "slot",
                "description": "Counters spells up to the slot level used, automatically."
              },
              "check": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ability",
                  "dc_base",
                  "plus"
                ],
                "description": "Higher-level spells: ability check, DC dc_base + spell level.",
                "properties": {
                  "ability": {
                    "const": "spellcasting"
                  },
                  "dc_base": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "plus": {
                    "const": "spell_level"
                  }
                }
              },
              "description": {
                "type": "string"
              },
              "applies_to": {
                "enum": [
                  "all",
                  "affected"
                ],
                "description": "Effects after the first only: 'affected' resolves this effect only for the targets the previous effect affected (spell attack: hit; save: failed; heal: healed; auto_hit: struck; apply_condition: received it). Default 'all'."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "apply_condition"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "kind",
              "condition"
            ],
            "properties": {
              "kind": {
                "const": "apply_condition"
              },
              "condition": {
                "$ref": "../common/v1.schema.json#/$defs/condition",
                "description": "Applied to each target with no saving throw; lasts with the spell's duration (Invisibility)."
              },
              "applies_to": {
                "enum": [
                  "all",
                  "affected"
                ],
                "description": "Effects after the first only: 'affected' resolves this effect only for the targets the previous effect affected (spell attack: hit; save: failed; heal: healed; auto_hit: struck; apply_condition: received it). Default 'all'."
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "apply_modifier"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "kind",
              "modifier"
            ],
            "properties": {
              "kind": {
                "const": "apply_modifier"
              },
              "modifier": {
                "$ref": "../common/v2.schema.json#/$defs/modifier"
              },
              "description": {
                "type": "string"
              },
              "applies_to": {
                "enum": [
                  "all",
                  "affected"
                ],
                "description": "Effects after the first only (a rider, Guiding Bolt): 'affected' resolves this effect only for the targets the previous effect affected. Default 'all'."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "zone"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "kind",
              "zone"
            ],
            "properties": {
              "kind": {
                "const": "zone"
              },
              "zone": {
                "$ref": "#/$defs/zone"
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      ],
      "description": "Discriminated by 'kind' (if/then per kind, so errors name the exact field)."
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "size_ft",
        "anchor"
      ],
      "description": "R-G11 persistent zone or aura (rules5e::ZoneSpec on SpellDef::zone; docs/CONTENT_CONVENTIONS.md section 4 is the loader contract). Kind 'zone' is the spell's primary effect only (effects[0]). Discriminated by 'shape'; each arm is a closed propertyNames allow-list (tests/validate/test_union_arms.py). The spell's duration is the zone's lifetime; concentration ends it.",
      "properties": {
        "shape": {
          "enum": [
            "sphere",
            "cylinder",
            "cube"
          ],
          "description": "AreaShape (line / walls: rules PR 2, appended later)."
        },
        "size_ft": {
          "type": "integer",
          "minimum": 5,
          "maximum": 65530,
          "multipleOf": 5,
          "description": "Sphere / cylinder radius, cube side."
        },
        "height_ft": {
          "type": "integer",
          "minimum": 5,
          "maximum": 65530,
          "multipleOf": 5,
          "description": "cylinder only."
        },
        "anchor": {
          "enum": [
            "point",
            "creature"
          ],
          "description": "point: fixed at a tile within range (sim's zone_x / zone_y); creature: an aura centred on the caster that moves with it (needs range self)."
        },
        "flags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "difficult",
              "light_obscured",
              "heavy_obscured",
              "magical_darkness",
              "silence",
              "halve_speed",
              "opaque"
            ]
          },
          "description": "Terrain / sense data for sim (kZone* bits, in this order: 1 difficult, 2 light_obscured, 4 heavy_obscured, 8 magical_darkness, 16 silence, 32 halve_speed, 64 opaque). light_obscured and heavy_obscured are exclusive (validator)."
        },
        "move": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cost",
            "feet"
          ],
          "description": "The caster can move a point zone on a later turn (Moonbeam: an action, 60 ft; D3). Omitted: the zone cannot be moved.",
          "properties": {
            "cost": {
              "enum": [
                "action",
                "bonus_action"
              ],
              "description": "ZoneSpec::move_cost 1 / 2."
            },
            "feet": {
              "type": "integer",
              "minimum": 5,
              "maximum": 65530,
              "multipleOf": 5,
              "description": "ZoneSpec::move_ft: farthest move."
            }
          }
        },
        "chooses_excluded": {
          "type": "boolean",
          "description": "The caster designates creatures the zone does not affect (Spirit Guardians)."
        },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/zone_trigger"
          },
          "description": "Trigger rows, in resolution order (ZoneTriggerRow)."
        },
        "needs_conscious_owner": {
          "type": "boolean",
          "description": "The zone / aura only functions while its owner is conscious (D7; ZoneSpec::needs_conscious_owner). Default false."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "shape"
            ],
            "properties": {
              "shape": {
                "enum": [
                  "sphere",
                  "cube"
                ]
              }
            }
          },
          "then": {
            "propertyNames": {
              "enum": [
                "shape",
                "size_ft",
                "anchor",
                "flags",
                "move",
                "chooses_excluded",
                "triggers",
                "needs_conscious_owner"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "shape"
            ],
            "properties": {
              "shape": {
                "const": "cylinder"
              }
            }
          },
          "then": {
            "required": [
              "height_ft"
            ],
            "propertyNames": {
              "enum": [
                "shape",
                "size_ft",
                "height_ft",
                "anchor",
                "flags",
                "move",
                "chooses_excluded",
                "triggers",
                "needs_conscious_owner"
              ]
            }
          }
        }
      ]
    },
    "zone_trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on",
        "effect"
      ],
      "description": "One ZoneTriggerRow. Not spell@1 casting_time.trigger (a reaction window) and not common@2 on_event 'on'.",
      "properties": {
        "on": {
          "enum": [
            "zone_appear",
            "zone_enter",
            "zone_start_turn",
            "zone_end_turn",
            "zone_move_within"
          ],
          "description": "ZoneTrigger Appear / Enter / StartTurn / EndTurn / MoveWithin."
        },
        "group": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Once-per-turn group (default 1; 0 = no limit). Rows sharing a group fire once per creature per zone per turn (Enter + StartTurn, D2)."
        },
        "own_turn_only": {
          "type": "boolean",
          "description": "zone_enter / zone_move_within only: only during the creature's own turn (Web)."
        },
        "completely_within": {
          "type": "boolean",
          "description": "The creature's whole footprint must be inside (Stinking Cloud)."
        },
        "counts_aura_move_as_enter": {
          "type": "boolean",
          "description": "zone_enter only: the zone moving onto the creature counts as entering (D1; default no)."
        },
        "while_in_zone": {
          "type": "boolean",
          "description": "The effect's condition lasts while the creature stays in the zone (Web); needs a condition."
        },
        "effect": {
          "$ref": "#/$defs/zone_effect"
        }
      }
    },
    "zone_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "description": "What a zone trigger does (a SpellEffect). save: a saving throw against the caster's spell save DC, damage (on_success) and/or a condition on a failure. damage: no save, the damage (and condition) always apply. apply_condition: no save, the condition always applies. Damage dice gain scaling.upcast.dice per slot level above the spell's level. Discriminated by 'kind'; closed propertyNames arms.",
      "properties": {
        "kind": {
          "enum": [
            "save",
            "damage",
            "apply_condition"
          ]
        },
        "ability": {
          "$ref": "../common/v1.schema.json#/$defs/ability"
        },
        "damage": {
          "$ref": "#/$defs/damage"
        },
        "on_success": {
          "enum": [
            "half",
            "none"
          ],
          "description": "save only: damage on a successful save."
        },
        "condition": {
          "$ref": "../common/v1.schema.json#/$defs/condition"
        },
        "description": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "save"
              }
            }
          },
          "then": {
            "required": [
              "ability"
            ],
            "anyOf": [
              {
                "required": [
                  "damage"
                ]
              },
              {
                "required": [
                  "condition"
                ]
              }
            ],
            "dependentRequired": {
              "damage": [
                "on_success"
              ],
              "on_success": [
                "damage"
              ]
            },
            "propertyNames": {
              "enum": [
                "kind",
                "ability",
                "damage",
                "on_success",
                "condition",
                "description"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "damage"
              }
            }
          },
          "then": {
            "required": [
              "damage"
            ],
            "propertyNames": {
              "enum": [
                "kind",
                "damage",
                "condition",
                "description"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "apply_condition"
              }
            }
          },
          "then": {
            "required": [
              "condition"
            ],
            "propertyNames": {
              "enum": [
                "kind",
                "condition",
                "description"
              ]
            }
          }
        }
      ]
    }
  }
}
