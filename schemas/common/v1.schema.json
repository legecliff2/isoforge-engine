{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isoforge.dev/schemas/common/v1.schema.json",
  "title": "common@1 shared definitions (creature stat blocks, ids)",
  "description": "Shared $defs for monster@1 and character@1. Immutable once released (ARCHITECTURE.md §3.2). All numbers are integers (§4.3).",
  "$defs": {
    "content_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$",
      "description": "Dotted, lowercase content id, e.g. 'srd51.monster.goblin'."
    },
    "schema_tag": { "type": "string", "pattern": "^[a-z_]+@[1-9][0-9]*$" },
    "dice": {
      "type": "string",
      "pattern": "^[1-9][0-9]*d(4|6|8|10|12|20|100)([+-][0-9]+)?$",
      "description": "Dice expression 'NdS[+/-B]' (maps to rules5e::DiceExpr)."
    },
    "ability": { "enum": ["str", "dex", "con", "int", "wis", "cha"] },
    "ability_score": { "type": "integer", "minimum": 1, "maximum": 30 },
    "abilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["str", "dex", "con", "int", "wis", "cha"],
      "properties": {
        "str": { "$ref": "#/$defs/ability_score" },
        "dex": { "$ref": "#/$defs/ability_score" },
        "con": { "$ref": "#/$defs/ability_score" },
        "int": { "$ref": "#/$defs/ability_score" },
        "wis": { "$ref": "#/$defs/ability_score" },
        "cha": { "$ref": "#/$defs/ability_score" }
      }
    },
    "saving_throws": {
      "type": "object",
      "description": "Total save bonus for each proficient save only (SRD stat-block convention).",
      "additionalProperties": false,
      "properties": {
        "str": { "type": "integer" }, "dex": { "type": "integer" }, "con": { "type": "integer" },
        "int": { "type": "integer" }, "wis": { "type": "integer" }, "cha": { "type": "integer" }
      }
    },
    "skill": {
      "enum": ["acrobatics", "animal_handling", "arcana", "athletics", "deception", "history",
               "insight", "intimidation", "investigation", "medicine", "nature", "perception",
               "performance", "persuasion", "religion", "sleight_of_hand", "stealth", "survival"]
    },
    "skills": {
      "type": "object",
      "description": "Total bonus for each proficient skill only.",
      "propertyNames": { "$ref": "#/$defs/skill" },
      "additionalProperties": { "type": "integer" }
    },
    "size": { "enum": ["tiny", "small", "medium", "large", "huge", "gargantuan"] },
    "creature_type": {
      "enum": ["aberration", "beast", "celestial", "construct", "dragon", "elemental", "fey",
               "fiend", "giant", "humanoid", "monstrosity", "ooze", "plant", "undead"]
    },
    "alignment": {
      "enum": ["lawful good", "neutral good", "chaotic good", "lawful neutral", "neutral",
               "chaotic neutral", "lawful evil", "neutral evil", "chaotic evil", "unaligned",
               "any alignment", "any non-good alignment", "any non-lawful alignment",
               "any chaotic alignment", "any evil alignment"]
    },
    "armor_class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "integer", "minimum": 0, "maximum": 127 },
        "note": { "type": "string" }
      }
    },
    "hit_points": {
      "type": "object",
      "additionalProperties": false,
      "required": ["average", "formula"],
      "properties": {
        "average": { "type": "integer", "minimum": 1, "maximum": 32767 },
        "formula": { "$ref": "#/$defs/dice" }
      }
    },
    "speed": {
      "type": "object",
      "description": "Speeds in feet (multiples of 5; 1 tile = 5 ft).",
      "additionalProperties": false,
      "required": ["walk"],
      "properties": {
        "walk":   { "$ref": "#/$defs/feet" },
        "burrow": { "$ref": "#/$defs/feet" },
        "climb":  { "$ref": "#/$defs/feet" },
        "fly":    { "$ref": "#/$defs/feet" },
        "swim":   { "$ref": "#/$defs/feet" },
        "hover":  { "type": "boolean" }
      }
    },
    "feet": { "type": "integer", "minimum": 0, "maximum": 255, "multipleOf": 5 },
    "senses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passive_perception"],
      "properties": {
        "blindsight":  { "$ref": "#/$defs/range_ft" },
        "darkvision":  { "$ref": "#/$defs/range_ft" },
        "tremorsense": { "$ref": "#/$defs/range_ft" },
        "truesight":   { "$ref": "#/$defs/range_ft" },
        "passive_perception": { "type": "integer", "minimum": 0 }
      }
    },
    "range_ft": { "type": "integer", "minimum": 0, "multipleOf": 5 },
    "languages": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "damage_type": {
      "enum": ["acid", "bludgeoning", "cold", "fire", "force", "lightning", "necrotic",
               "piercing", "poison", "psychic", "radiant", "slashing", "thunder"]
    },
    "condition": {
      "enum": ["blinded", "charmed", "deafened", "frightened", "grappled", "incapacitated",
               "invisible", "paralyzed", "petrified", "poisoned", "prone", "restrained",
               "stunned", "unconscious", "exhaustion"]
    },
    "damage_types": { "type": "array", "items": { "$ref": "#/$defs/damage_type" }, "uniqueItems": true },
    "local_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "trait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/local_id" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "effect": {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "type": "string", "pattern": "^[a-z0-9_]+$" } },
          "description": "Machine-readable effect; kinds are interpreted by sim/rules adapters."
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/local_id" },
        "name": { "type": "string" },
        "kind": { "enum": ["melee_weapon_attack", "ranged_weapon_attack", "melee_spell_attack",
                           "ranged_spell_attack", "special"] },
        "to_hit": { "type": "integer", "minimum": -128, "maximum": 127 },
        "reach": { "$ref": "#/$defs/feet" },
        "range": {
          "type": "array", "prefixItems": [ { "$ref": "#/$defs/range_ft" }, { "$ref": "#/$defs/range_ft" } ],
          "minItems": 2, "maxItems": 2, "description": "[normal, long] in feet."
        },
        "targets": { "type": "integer", "minimum": 1 },
        "properties": { "type": "array", "items": { "type": "string" }, "uniqueItems": true,
                        "description": "Weapon properties, e.g. 'finesse', 'light', 'ammunition', 'versatile'." },
        "damage": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["dice", "type"],
            "properties": { "dice": { "$ref": "#/$defs/dice" }, "type": { "$ref": "#/$defs/damage_type" } }
          }
        },
        "description": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "pattern": "_attack$" } } },
          "then": { "required": ["to_hit", "damage"] } },
        { "if": { "properties": { "kind": { "pattern": "^melee_" } } },
          "then": { "required": ["reach"] } },
        { "if": { "properties": { "kind": { "pattern": "^ranged_" } } },
          "then": { "required": ["range"] } }
      ]
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["ref", "license"],
      "properties": { "ref": { "type": "string" }, "license": { "type": "string" } }
    },
    "presentation": {
      "type": "object",
      "description": "Presentation-only references; never read by rules5e adapters (§5.4).",
      "additionalProperties": false,
      "properties": {
        "sprite": { "type": "string" }, "portrait": { "type": "string" }, "ai": { "type": "string" }
      }
    },
    "stat_block": {
      "description": "Fields shared by monsters and characters.",
      "type": "object",
      "required": ["$schema", "id", "name", "source", "size", "type", "alignment", "armor_class",
                   "hit_points", "speed", "abilities", "proficiency_bonus", "senses", "languages", "actions"],
      "properties": {
        "$schema": { "$ref": "#/$defs/schema_tag" },
        "id": { "$ref": "#/$defs/content_id" },
        "name": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "size": { "$ref": "#/$defs/size" },
        "type": { "$ref": "#/$defs/creature_type" },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "alignment": { "$ref": "#/$defs/alignment" },
        "armor_class": { "$ref": "#/$defs/armor_class" },
        "hit_points": { "$ref": "#/$defs/hit_points" },
        "speed": { "$ref": "#/$defs/speed" },
        "abilities": { "$ref": "#/$defs/abilities" },
        "saving_throws": { "$ref": "#/$defs/saving_throws" },
        "skills": { "$ref": "#/$defs/skills" },
        "damage_vulnerabilities": { "$ref": "#/$defs/damage_types" },
        "damage_resistances": { "$ref": "#/$defs/damage_types" },
        "damage_immunities": { "$ref": "#/$defs/damage_types" },
        "condition_immunities": { "type": "array", "items": { "$ref": "#/$defs/condition" }, "uniqueItems": true },
        "senses": { "$ref": "#/$defs/senses" },
        "languages": { "$ref": "#/$defs/languages" },
        "proficiency_bonus": { "type": "integer", "minimum": 2, "maximum": 9 },
        "traits": { "type": "array", "items": { "$ref": "#/$defs/trait" } },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "bonus_actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "reactions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "presentation": { "$ref": "#/$defs/presentation" }
      }
    }
  }
}
