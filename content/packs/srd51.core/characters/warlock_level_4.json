  "features": [
    {
      "id": "dark_ones_blessing",
      "name": "Dark One's Blessing",
      "description": "Starting at 1st level, when you reduce a hostile creature to 0 hit points, you gain temporary hit points equal to your Charisma modifier + your warlock level (minimum of 1) (8).",
      "effect": {
        "kind": "on_event",
        "on": "reduce_to_zero",
        "when": [
          {
            "kind": "subject_hostile"
          }
        ],
        "effects": [
          {
            "kind": "temp_hp",
            "amount_from": {
              "ability": "cha",
              "class": "warlock"
            }
          }
        ]
      }
    },
    {
      "id": "eldritch_invocations",
      "name": "Eldritch Invocations",
      "description": "You know 2 eldritch invocations: Agonizing Blast, Armor of Shadows. (Armor of Shadows is baked into armor_class; see those features.)"
    },
    {
      "id": "agonizing_blast",
      "name": "Agonizing Blast",
      "description": "When you cast eldritch blast, add your Charisma modifier to the damage it deals on a hit. (Modelled: spell_mod eldritch_blast, + Cha modifier per beam that hits.)",
      "effect": {
        "kind": "spell_mod",
        "spell": "srd51.spell.eldritch_blast",
        "damage_bonus_ability": "cha"
      }
    },
    {
      "id": "armor_of_shadows",
      "name": "Armor of Shadows",
      "description": "You can cast mage armor on yourself at will, without expending a spell slot or material components. (Baked: mage armor lasts 8 hours and costs nothing, so armor_class is 13 + Dex with no armor worn.)"
    },
    {
      "id": "pact_of_the_tome",
      "name": "Pact Boon: Pact of the Tome",
      "description": "Your patron gives you a grimoire called a Book of Shadows. Choose three cantrips from any class's spell list (they needn't be from the same list); while the book is on your person, you can cast them at will. They are warlock spells for you. Chosen: Fire Bolt, Ray of Frost, Sacred Flame (in spellcasting.spells)."
    }
  ],
