  "features": [
    {
      "id": "fighting_style_dueling",
      "name": "Fighting Style: Dueling",
      "description": "When you are wielding a melee weapon in one hand and no other weapons, you gain a +2 bonus to damage rolls with that weapon.",
      "effect": {
        "kind": "damage_bonus",
        "amount": 2,
        "condition": "one_handed_melee_no_other_weapon"
      }
    },
    {
      "id": "second_wind",
      "name": "Second Wind",
      "description": "On your turn, you can use a bonus action to regain hit points equal to 1d10 + your fighter level. Once you use this feature, you must finish a short or long rest before you can use it again.",
      "effect": {
        "kind": "self_heal",
        "dice": "1d10",
        "plus": "fighter_level",
        "uses": 1,
        "recharge": "short_rest",
        "cost": "bonus_action"
      }
    },
    {
      "id": "action_surge",
      "name": "Action Surge",
      "description": "On your turn, you can take one additional action on top of your regular action and a possible bonus action. Once you use this feature, you must finish a short or long rest before you can use it again.",
      "effect": {
        "kind": "grant_action",
        "cost": "free",
        "usage": {
          "kind": "per_rest",
          "uses": 1,
          "rest": "short"
        }
      }
    },
    {
      "id": "improved_critical",
      "name": "Improved Critical",
      "description": "Your weapon attacks score a critical hit on a roll of 19 or 20.",
      "effect": {
        "kind": "crit_range",
        "min": 19
      }
    },
    {
      "id": "extra_attack",
      "name": "Extra Attack",
      "description": "You can attack twice, instead of once, whenever you take the Attack action on your turn. Declared as one multiattack option (two longsword attacks); see docs/SRD_CLASSES_DEFERRED.md.",
      "effect": {
        "kind": "multiattack",
        "options": [
          {
            "id": "longsword_x2",
            "attacks": [
              "longsword",
              "longsword"
            ]
          }
        ]
      }
    }
  ],
