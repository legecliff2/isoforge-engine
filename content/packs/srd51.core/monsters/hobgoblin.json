  "traits": [
    {
      "id": "martial_advantage",
      "name": "Martial Advantage",
      "description": "Once per turn, the hobgoblin can deal an extra 7 (2d6) damage to a creature it hits with a weapon attack if that creature is within 5 feet of an ally of the hobgoblin that isn't incapacitated.",
      "effect": {
        "kind": "on_event",
        "on": "hit",
        "limit": "once_per_turn",
        "when": [
          {
            "kind": "weapon_attack"
          },
          {
            "kind": "ally_near_target"
          }
        ],
        "effects": [
          {
            "kind": "extra_damage",
            "damage": [
              {
                "dice": "2d6",
                "type": "same_as_weapon"
              }
            ]
          }
        ]
      }
    }
  ],
  "actions": [
    {
      "id": "longsword",
      "name": "Longsword",
      "kind": "melee_weapon_attack",
      "to_hit": 3,
      "reach": 5,
      "targets": 1,
      "damage": [
        {
          "dice": "1d8+1",
          "type": "slashing"
        }
      ],
      "description": "Melee Weapon Attack: +3 to hit, reach 5 ft., one target. Hit: 5 (1d8 + 1) slashing damage, or 6 (1d10 + 1) slashing damage if used with two hands."
    },
    {
      "id": "longsword_two_handed",
      "name": "Longsword (two hands)",
      "kind": "melee_weapon_attack",
      "to_hit": 3,
      "reach": 5,
      "targets": 1,
      "damage": [
        {
          "dice": "1d10+1",
          "type": "slashing"
        }
      ],
      "description": "Melee Weapon Attack: +3 to hit, reach 5 ft., one target. Hit: 5 (1d8 + 1) slashing damage, or 6 (1d10 + 1) slashing damage if used with two hands."
    },
    {
      "id": "longbow",
      "name": "Longbow",
      "kind": "ranged_weapon_attack",
      "to_hit": 3,
      "range": [
        150,
        600
      ],
      "targets": 1,
      "damage": [
        {
          "dice": "1d8+1",
          "type": "piercing"
        }
      ],
      "description": "Ranged Weapon Attack: +3 to hit, range 150/600 ft., one target. Hit: 5 (1d8 + 1) piercing damage."
    }
  ]
