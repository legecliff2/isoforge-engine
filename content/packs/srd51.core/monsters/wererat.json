  "traits": [
    {
      "id": "damage_immunities_nonmagical",
      "name": "Damage Immunities",
      "description": "Immune to bludgeoning, piercing, and slashing from nonmagical weapons that aren't silvered.",
      "effect": {
        "kind": "damage_mitigation",
        "immunities": {
          "nonmagical_not_silvered": [
            "bludgeoning",
            "piercing",
            "slashing"
          ]
        }
      }
    },
    {
      "id": "shapechanger",
      "name": "Shapechanger",
      "description": "The wererat can use its action to polymorph into a rat-humanoid hybrid or into a giant rat, or back into its true form, which is humanoid. Its statistics, other than its size, are the same in each form. Any equipment it is wearing or carrying isn't transformed. It reverts to its true form if it dies. (CONTENT_CONVENTIONS §58. AC 12 and walk 30 in every form. True form: Medium, shortsword and hand crossbow. Hybrid: Medium, those weapons and bite. Rat: Small, darkvision 60, bite only. Keen Smell stays description-only. Can't speak in rat form is not a speech rule.)",
      "effect": {
        "kind": "shapechanger",
        "cost": "action",
        "true_form": {
          "actions": [
            "shortsword",
            "hand_crossbow",
            "shortsword_x2",
            "hand_crossbow_x2",
            "shortsword_hand_crossbow",
            "hand_crossbow_shortsword"
          ]
        },
        "forms": [
          {
            "id": "hybrid",
            "name": "Hybrid",
            "size": "medium",
            "actions": [
              "shortsword",
              "hand_crossbow",
              "bite",
              "shortsword_x2",
              "hand_crossbow_x2",
              "shortsword_hand_crossbow",
              "hand_crossbow_shortsword",
              "shortsword_bite",
              "bite_shortsword",
              "hand_crossbow_bite",
              "bite_hand_crossbow"
            ]
          },
          {
            "id": "rat",
            "name": "Rat",
            "size": "small",
            "senses": {
              "darkvision": 60
            },
            "actions": [
              "bite"
            ]
          }
        ]
      }
    },
    {
      "id": "keen_smell",
      "name": "Keen Smell",
      "description": "The wererat has advantage on Wisdom (Perception) checks that rely on smell."
    },
    {
      "id": "multiattack",
      "name": "Multiattack",
      "description": "The wererat makes two attacks, only one of which can be a bite. (Humanoid or Hybrid Form Only. Humanoid: two shortswords, two hand crossbows, or one of each, either order. Hybrid adds a shortsword or hand crossbow with one bite, either order.)",
      "effect": {
        "kind": "multiattack",
        "options": [
          {
            "id": "shortsword_x2",
            "attacks": [
              "shortsword",
              "shortsword"
            ]
          },
          {
            "id": "hand_crossbow_x2",
            "attacks": [
              "hand_crossbow",
              "hand_crossbow"
            ]
          },
          {
            "id": "shortsword_hand_crossbow",
            "attacks": [
              "shortsword",
              "hand_crossbow"
            ]
          },
          {
            "id": "hand_crossbow_shortsword",
            "attacks": [
              "hand_crossbow",
              "shortsword"
            ]
          },
          {
            "id": "shortsword_bite",
            "attacks": [
              "shortsword",
              "bite"
            ]
          },
          {
            "id": "bite_shortsword",
            "attacks": [
              "bite",
              "shortsword"
            ]
          },
          {
            "id": "hand_crossbow_bite",
            "attacks": [
              "hand_crossbow",
              "bite"
            ]
          },
          {
            "id": "bite_hand_crossbow",
            "attacks": [
              "bite",
              "hand_crossbow"
            ]
          }
        ]
      }
    }
  ],
  "actions": [
    {
      "id": "bite",
      "name": "Bite",
      "kind": "melee_weapon_attack",
      "natural": {
        "dice": "1d4",
        "ability": "dex"
      },
      "ability": "dex",
      "to_hit": 4,
      "reach": 5,
      "targets": 1,
      "damage": [
        {
          "dice": "1d4+2",
          "type": "piercing"
        }
      ],
      "description": "Bite (Rat or Hybrid Form Only). Melee Weapon Attack: +4 to hit, reach 5 ft., one target. Hit: 4 (1d4 + 2) piercing damage. If the target is a humanoid, it must succeed on a DC 11 Constitution saving throw or be cursed with wererat lycanthropy. (The lycanthropy curse stays description-only. HOLD. No save is rolled. +4 and +2 are Dex, not Str.)"
    },
    {
      "id": "shortsword",
      "name": "Shortsword",
      "kind": "melee_weapon_attack",
      "weapon": "srd51.item.shortsword",
      "ability": "dex",
      "to_hit": 4,
      "reach": 5,
      "targets": 1,
      "damage": [
        {
          "dice": "1d6+2",
          "type": "piercing"
        }
      ],
      "description": "Melee Weapon Attack: +4 to hit, reach 5 ft., one target. Hit: 5 (1d6 + 2) piercing damage."
    },
    {
      "id": "hand_crossbow",
      "name": "Hand Crossbow",
      "kind": "ranged_weapon_attack",
      "weapon": "srd51.item.crossbow_hand",
      "ability": "dex",
