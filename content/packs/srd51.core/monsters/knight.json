    "str": 16,
    "dex": 11,
    "con": 14,
    "int": 11,
    "wis": 11,
    "cha": 15
  },
  "senses": {
    "passive_perception": 10
  },
  "languages": [
    "any one language (usually Common)"
  ],
  "challenge": {
    "rating": "3",
    "xp": 700
  },
  "proficiency_bonus": 2,
  "saving_throws": {
    "con": 4,
    "wis": 2
  },
  "traits": [
    {
      "id": "brave",
      "name": "Brave",
      "description": "The knight has advantage on saving throws against being frightened."
    },
    {
      "id": "multiattack",
      "name": "Multiattack",
      "description": "The knight makes two melee attacks.",
      "effect": {
        "kind": "multiattack",
        "options": [
          {
            "id": "greatsword_x2",
            "attacks": [
              "greatsword",
              "greatsword"
            ]
          }
        ]
      }
    }
  ],
  "actions": [
    {
      "id": "greatsword",
      "name": "Greatsword",
      "kind": "melee_weapon_attack",
      "weapon": "srd51.item.greatsword",
      "use": "two_hands",
      "to_hit": 5,
      "reach": 5,
      "properties": [
        "two_handed"
      ],
      "targets": 1,
      "damage": [
        {
          "dice": "2d6+3",
          "type": "slashing"
        }
      ]
    },
    {
      "id": "heavy_crossbow",
      "name": "Heavy Crossbow",
      "kind": "ranged_weapon_attack",
      "weapon": "srd51.item.crossbow_heavy",
      "to_hit": 2,
      "range": [
        100,
        400
      ],
      "targets": 1,
      "damage": [
        {
          "dice": "1d10",
          "type": "piercing"
        }
      ]
    },
    {
      "id": "leadership",
      "name": "Leadership (Recharges after a Short or Long Rest)",
      "kind": "special",
      "description": "For 1 minute, the knight can utter a special command or warning whenever a nonhostile creature that it can see within 30 feet of it makes an attack roll or a saving throw. The creature can add a d4 to its roll provided it can hear and understand the knight. A creature can benefit from only one Leadership die at a time. This effect ends if the knight is incapacitated."
    }
  ],
  "reactions": [
    {
      "id": "parry",
      "name": "Parry",
      "description": "The knight adds 2 to its AC against one melee attack that would hit it. To do so, the knight must see the attacker and be wielding a melee weapon.",
      "window": {
        "kind": "being_hit",
        "melee_only": true,
        "requires_sight": true
      },
      "effect": {
        "kind": "ac_bonus",
        "bonus": 2
      }
    }
  ]
