  },
  "components": {
    "v": true,
    "s": true
  },
  "duration": {
    "kind": "instantaneous"
  },
  "effects": [
    {
      "kind": "stabilize",
      "excludes_creature_type": [
        "undead",
        "construct"
      ]
    }
  ]
}
