    "bard",
    "cleric",
    "druid",
    "paladin",
    "ranger"
  ],
  "casting_time": {
    "kind": "action"
  },
  "range": {
    "kind": "touch"
  },
  "components": {
    "v": true,
    "s": true
  },
  "duration": {
    "kind": "instantaneous"
  },
  "effects": [
    {
      "kind": "end_condition",
      "conditions": [
        "blinded",
        "deafened",
        "paralyzed",
        "poisoned"
      ]
    }
  ]
}
