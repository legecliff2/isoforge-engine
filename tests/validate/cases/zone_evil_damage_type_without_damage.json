  "id": "test.neg.spell.zone_evil_damage_type_without_damage",
  "name": "Stinking Cloud",
  "description": "A 20-foot-radius sphere of nauseating gas within range; heavily obscured. A creature completely within the cloud at the start of its turn makes a Constitution save against poison; on a failure it spends its action that turn retching. Creatures that don't need to breathe or are immune to poison automatically succeed.",
  "level": 3,
  "school": "conjuration",
  "classes": [
    "bard",
    "sorcerer",
    "wizard"
  ],
  "casting_time": {
    "kind": "action"
  },
  "range": {
    "kind": "ranged",
    "feet": 90
  },
  "components": {
    "v": true,
    "s": true,
    "m": {
      "text": "a rotten egg or several skunk cabbage leaves"
    }
  },
  "duration": {
    "kind": "minutes",
    "amount": 1,
    "concentration": true
  },
  "effects": [
    {
      "kind": "zone",
      "zone": {
        "shape": "sphere",
        "size_ft": 20,
        "anchor": "point",
        "flags": [
          "heavy_obscured"
        ],
        "triggers": [
          {
            "on": "zone_start_turn",
            "completely_within": true,
            "loses_action": true,
            "auto_success_damage": [
              "poison"
            ],
            "auto_success_conditions": [
              "poisoned"
            ],
            "auto_success_no_breath": true,
            "effect": {
              "kind": "save",
              "ability": "con",
              "condition": "incapacitated"
            },
            "evil_damage_type": "necrotic"
          }
        ]
      }
    }
  ]
}
