    "feet": 120
  },
  "components": {
    "v": true,
    "s": true
  },
  "duration": {
    "kind": "hours",
    "amount": 1,
    "concentration": true
  },
  "effects": [
    {
      "kind": "zone",
      "zone": {
        "shape": "sphere",
        "size_ft": 20,
        "anchor": "point",
        "flags": [
          "heavy_obscured"
