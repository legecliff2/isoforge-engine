cmake_minimum_required(VERSION 3.28)
# cmake -DGRAPH=<build>/depgraph.txt -DRULES=tools/depcheck/rules.cmake -P depcheck.cmake
# Enforces ARCHITECTURE.md §2.2 rule 1 (acyclic, downward only) and the third-party part of
# rules 2/3 on the real CMake target graph emitted by cmake/DepCheck.cmake.
include("${RULES}")
file(STRINGS "${GRAPH}" lines)
set(errors "")

# closure(X): everything reachable from X through the ALLOW table; detects cycles.
function(_closure mod out stack)
    if("${mod}" IN_LIST stack)
        list(JOIN stack " -> " s)
        message(FATAL_ERROR "depcheck: rules table has a cycle: ${s} -> ${mod}")
    endif()
    set(res "")
    foreach(d IN LISTS ALLOW_${mod})
        list(APPEND res "${d}")
        _closure("${d}" sub "${stack};${mod}")
        list(APPEND res ${sub})
    endforeach()
    list(REMOVE_DUPLICATES res)
    set(${out} "${res}" PARENT_SCOPE)
endfunction()

set(n 0)
foreach(line IN LISTS lines)
    if(NOT line MATCHES "^([^=]+)=(.*)$")
        continue()
    endif()
    set(mod "${CMAKE_MATCH_1}")
    string(REPLACE "," ";" deps "${CMAKE_MATCH_2}")
    math(EXPR n "${n}+1")
    if(NOT DEFINED ALLOW_${mod})
        string(APPEND errors "  ${mod}: module missing from tools/depcheck/rules.cmake (add it per §2.1)\n")
        continue()
    endif()
    _closure("${mod}" reach "")
    foreach(d IN LISTS deps)
        if(d MATCHES "^ext:(.*)$")
            set(x "${CMAKE_MATCH_1}")
            if(NOT x IN_LIST EXT_${mod} AND NOT x IN_LIST EXT_ANY)
                string(APPEND errors "  ${mod} -> ${x}: third-party dependency not allowed for ${mod}\n")
            endif()
        elseif(NOT d IN_LIST reach)
            string(APPEND errors "  ${mod} -> ${d}: not a downward edge (allowed: ${reach})\n")
        endif()
    endforeach()
endforeach()

if(n EQUAL 0)
    message(FATAL_ERROR "depcheck: no modules found in ${GRAPH}")
endif()
if(errors)
    message(FATAL_ERROR "depcheck: module dependency rules violated (ARCHITECTURE.md §2.1/§2.2):\n${errors}")
endif()
message(STATUS "depcheck: OK (${n} modules)")
