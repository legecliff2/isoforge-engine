cmake_minimum_required(VERSION 3.28)
# Run encounter_runner twice and require byte-identical stdout, then compare that
# stdout to the checked-in golden. --log is also run twice and must match itself.
if(NOT RUNNER OR NOT SCENARIO OR NOT GOLDEN OR NOT ROOT)
    message(FATAL_ERROR "check_scenario: RUNNER, SCENARIO, GOLDEN and ROOT are required")
endif()

function(_norm out_var text)
    string(REPLACE "\r\n" "\n" text "${text}")
    set(${out_var} "${text}" PARENT_SCOPE)
endfunction()

function(_run log_flag out_var err_var)
    if(log_flag)
        execute_process(COMMAND "${RUNNER}" --root "${ROOT}" --log "${SCENARIO}"
                        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    else()
        execute_process(COMMAND "${RUNNER}" --root "${ROOT}" "${SCENARIO}"
                        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    endif()
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "encounter_runner failed (${rc}): ${err}\n${out}")
    endif()
    if(NOT err STREQUAL "")
        message(FATAL_ERROR "encounter_runner wrote to stderr:\n${err}")
    endif()
    _norm(out "${out}")
    set(${out_var} "${out}" PARENT_SCOPE)
    set(${err_var} "${err}" PARENT_SCOPE)
endfunction()

_run(0 first ignored)
_run(0 second ignored)
if(NOT first STREQUAL second)
    message(FATAL_ERROR "two runs differ:\n--- first ---\n${first}\n--- second ---\n${second}")
endif()

if(NOT EXISTS "${GOLDEN}")
    message(FATAL_ERROR "missing golden ${GOLDEN}\n--- runner stdout ---\n${first}")
endif()
file(READ "${GOLDEN}" expected)
_norm(expected "${expected}")
if(NOT first STREQUAL expected)
    message(FATAL_ERROR "golden mismatch for ${SCENARIO}\n--- got ---\n${first}\n--- expected ---\n${expected}")
endif()

_run(1 log_a ignored)
_run(1 log_b ignored)
if(NOT log_a STREQUAL log_b)
    message(FATAL_ERROR "--log output differed between two runs")
endif()
string(FIND "${log_a}" "${first}" _prefix)
if(NOT _prefix EQUAL 0)
    message(FATAL_ERROR "--log output does not start with the golden report")
endif()
